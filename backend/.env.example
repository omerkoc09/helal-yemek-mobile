# ── Zorunlu ──────────────────────────────────────────────────────────────────
# Bu ikisi eksik veya geçersizse uygulama HİÇ AÇILMAZ (config.Validate).
DATABASE_URL=postgres://caizmi:secret@localhost:5433/caizmi?sslmode=disable
# En az 32 karakter olmalı. Kısa/boş secret'ta süreç fail-fast yapar; aksi halde
# HS256 boş anahtarla imzalar ve tüm kimlik doğrulama sahtelenebilir hale gelir.
JWT_SECRET=supersecretkey_change_in_production

# ── Sunucu ───────────────────────────────────────────────────────────────────
PORT=8080

# ── Depolama ─────────────────────────────────────────────────────────────────
# YEREL DİSK modu (S3_ENDPOINT boşken kullanılır).
# STORAGE_URL fotoğraf URL'lerinin ön ekidir. Artık DB'ye yalnızca dosya
# ANAHTARI yazılır, tam URL okuma anında üretilir — bu değeri değiştirmek
# veri migrasyonu GEREKTİRMEZ (migration 039'dan itibaren).
# Emülatör/fiziksel cihazla test ederken makinenin LAN IP'si kullanılmalı
# (localhost emülatörün kendisini gösterir).
STORAGE_URL=http://localhost:8080
STORAGE_BUCKET=caizmi-photos

# S3 UYUMLU DEPOLAMA (opsiyonel). S3_ENDPOINT doluysa yerel disk yerine bu
# kullanılır. Yapılandırma hatalıysa uygulama açılışta fail-fast yapar.
# Aynı ayarlar AWS S3, Cloudflare R2, DigitalOcean Spaces ve MinIO ile çalışır.
#   AWS      : s3.<bolge>.amazonaws.com
#   R2       : <hesap-id>.r2.cloudflarestorage.com
#   MinIO    : localhost:9000  (docker-compose ile gelir, S3_USE_SSL=false)
# UYARI: yerel disk container katmanına yazar, restart'ta fotoğraflar KAYBOLUR.
# Prod'da ya volume bağlanmalı ya da S3 kullanılmalı.
# S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_USE_SSL=false
# CDN veya bucket'ın genel adresi. Boşsa endpoint+bucket'tan türetilir.
# S3_PUBLIC_BASE=http://localhost:9000/caizmi-photos

# ── Google ───────────────────────────────────────────────────────────────────
# Mobil istemcinin ID token'ının audience'ı ile AYNI olmalı, aksi halde
# Google ile giriş doğrulaması başarısız olur.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Places API çağrıları için. UYARI: bu anahtar fotoğraf URL'lerine gömülüp
# istemciye gönderiliyor — kısıtlama ve kota ayarı Cloud Console'da yapılmalı.
GOOGLE_MAPS_API_KEY=AIza...

# ── CORS ─────────────────────────────────────────────────────────────────────
# Web admin paneli için. Boş bırakılırsa "*" kullanılır; production'da
# spesifik origin'lere daraltılmalı. Virgülle ayrılır.
CORS_ALLOW_ORIGINS=*

# ── SMTP ─────────────────────────────────────────────────────────────────────
# SMTP_USER veya SMTP_PASSWORD BOŞSA e-posta gönderimi devre dışı kalır
# (NoopEmailService): mailler gönderilmez, sunucu loguna basılır. Şifre
# sıfırlama kodu da loga düşer:
#   [EMAIL NOOP] To: x@y.com | Subject: Şifre sıfırlama kodunuz | Kod: 042317
# Geliştirmede bu alanları BOŞ bırakmak en pratiği.
#
# DİKKAT: Buradaki örnek değerleri .env'e OLDUĞU GİBİ kopyalama. Boş olmadıkları
# için Noop devreye girmez; gerçek SMTP denenir, kimlik doğrulama başarısız olur
# ve kullanıcıya mail GİTMEZ — üstelik hata yalnızca logda görünür.
#
# ── Seçenek A: Üretim (Resend — önerilen) ──
# 3.000 mail/ay ücretsiz. resend.com'da alan adını doğrula, API anahtarı üret.
# SMTP_USER sabittir ("resend"), bir adres değildir — zarf adresi SMTP_FROM'dan
# alınır (bkz. envelopeFrom, email_service.go).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx
# SMTP_FROM=İtimat <noreply@kendi-alanadin.com>
#
# ── Seçenek B: Gmail (yalnızca deneme için) ──
# 2 adımlı doğrulama açıkken myaccount.google.com/apppasswords → 16 hane.
# Günlük ~500 mail sınırı var ve sıfırlama mailleri spam'e düşmeye müsait;
# üretimde önerilmez.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=gercek-adresin@gmail.com
# SMTP_PASSWORD=16-hane-bosluksuz
# SMTP_FROM=İtimat <gercek-adresin@gmail.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=İtimat <noreply@example.com>

# ── Dönemsel doğrulama zamanlayıcısı ─────────────────────────────────────────
# PERIOD: mekan onaylandıktan sonra yeniden doğrulama gerekene kadar geçen süre.
# WARNING: son tarihe bu kadar kala uyarı bildirimi gönderilir.
# ÖNEMLİ: WARNING değeri mobildeki _verificationWarningDays sabitiyle AYNI
# olmalı (verify_button_visibility.dart) — aksi halde buton ile bildirim
# eş zamanlı çıkmaz. Mobil değer env'den GELMEZ, elle senkronlanır.
VERIFICATION_PERIOD_DAYS=180
VERIFICATION_WARNING_DAYS=14
SCHEDULER_RUN_HOUR=2

# ── Loglama ──────────────────────────────────────────────────────────────────
# json: production (log toplama araçları için) | text: geliştirme (okunaklı)
LOG_FORMAT=json
# debug | info | warn | error — tanınmayan değer info'ya düşer
LOG_LEVEL=info
