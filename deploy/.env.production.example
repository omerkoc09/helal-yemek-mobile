# İtimat — üretim ortam değişkenleri ŞABLONU.
#
#   cp .env.production.example .env.production
#
# .env.production ASLA commit edilmez (deploy/.gitignore ile korunuyor).
# Yalnızca sunucuda bulunur, izinleri: chmod 600
#
# Her satırın yanında değerin NEREDEN alınacağı yazıyor.

# ── Domain ────────────────────────────────────────────────────────────────────
# Kayıt şirketinden aldığın alan adı, başında https:// ve www OLMADAN.
# Caddy buradan api.<domain> ve admin.<domain> sertifikalarını üretir.
DOMAIN=ornek.com

# Let's Encrypt sertifika bildirimleri bu adrese gider. Gerçek, okuduğun adres.
ACME_EMAIL=sen@ornek.com

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Bu üçü yalnızca compose ağı içinde kullanılır, dışarı açılmaz.
# ŞİFREYİ RASTGELE ÜRET:  openssl rand -base64 24
POSTGRES_DB=itimat
POSTGRES_USER=itimat
POSTGRES_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# EN AZ 32 KARAKTER — kısa/boşsa uygulama açılmaz (fail-fast, config.Validate).
# ÜRET:  openssl rand -base64 48
# Bu değeri değiştirmek TÜM kullanıcıların oturumunu kapatır (token'lar geçersizleşir).
JWT_SECRET=

# ── Depolama: Cloudflare R2 ───────────────────────────────────────────────────
# R2 panelinden: bucket oluştur, sonra "Manage R2 API Tokens" ile anahtar üret.
#
# S3_ENDPOINT  : <hesap-id>.r2.cloudflarestorage.com   (başında https:// YOK)
# S3_PUBLIC_BASE: bucket'ın herkese açık adresi. R2'de "Public Development URL"
#                 açarsan https://pub-xxxx.r2.dev, kendi alt alan adını
#                 bağlarsan https://cdn.<domain>. Fotoğraf adresleri bununla
#                 üretilir — YANLIŞSA fotoğraflar 404 döner.
# UYARI: Bu alanlar boş bırakılırsa yerel diske yazılır ve container yeniden
# başladığında TÜM FOTOĞRAFLAR SİLİNİR. Prod'da doldurulmalı.
S3_BUCKET=itimat-photos
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_BASE=

# ── Google ────────────────────────────────────────────────────────────────────
# Cloud Console > Credentials.
# GOOGLE_CLIENT_ID: mobil istemcinin ID token audience'ı ile AYNI olmalı,
#                   yoksa Google ile giriş çalışmaz.
GOOGLE_CLIENT_ID=
# Places API anahtarı. Fotoğraf proxy'si sayesinde bu anahtar istemciye
# GİTMİYOR → Cloud Console'da IP kısıtı koyabilirsin (sunucunun IP'si).
# Mobil SDK anahtarı bundan AYRI olmalı (yol haritası Adım 2).
GOOGLE_MAPS_API_KEY=

# ── SMTP: Resend ──────────────────────────────────────────────────────────────
# ÖNCE resend.com'da DOMAIN DOĞRULAMASI yapılmalı (DNS'e TXT/DKIM kayıtları).
# Gmail adresiyle çalışmaz — gönderen alan adı doğrulanmak zorunda.
#
# SMTP_USER  : Resend'de sabit "resend" kelimesidir (e-posta adresi değil).
# SMTP_PASSWORD: Resend API anahtarı (re_ ile başlar).
# SMTP_FROM  : doğrulanmış alan adında bir adres, "Ad <adres>" biçiminde.
#
# ⚠️ BOŞ BIRAKILIRSA e-posta sessizce devre dışı kalır (Noop): kullanıcı
# "kod gönderildi" görür ama mail gitmez. Şifre sıfırlama çalışmaz.
# ⚠️ YANLIŞ DOLDURULURSA da uygulama sessizce çalışır, hata sadece logda kalır.
# Doldurduktan sonra GERÇEK bir şifre sıfırlama isteğiyle test et.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
# TIRNAK ŞART: "<" karakteri tırnaksız bırakılırsa yedekleme scripti bu dosyayı
# source ederken shell yönlendirmesi sanıp hata verir (yerel denemede yakalandı).
SMTP_FROM="İtimat <noreply@ornek.com>"

# ── Yedekleme ─────────────────────────────────────────────────────────────────
# Yedekler ayrı bir R2 bucket'ına yüklenir (fotoğraflarla karışmasın).
# rclone yapılandırması için: deploy/README.md → "Yedekleme".
BACKUP_BUCKET=itimat-backups
BACKUP_RETENTION_DAYS=7

# ── Scheduler / loglama (varsayılanlar yeterli) ───────────────────────────────
# Mekan doğrulama periyodu ve uyarı penceresi. DİKKAT: WARNING_DAYS değiştirilirse
# mobildeki hardcoded eşik (verify_button_visibility.dart) da elle güncellenmeli.
VERIFICATION_PERIOD_DAYS=180
VERIFICATION_WARNING_DAYS=14
SCHEDULER_RUN_HOUR=2
LOG_LEVEL=info
